KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL

# sasl
KAFKA_SASL_MECHANISM_INTER_BROKER_PROTOCOL=PLAIN
KAFKA_ALLOW_EVERYONE_IF_NO_ACL_FOUND="false"
KAFKA_SASL_ENABLED_MECHANISMS=PLAIN,SASL_SSL
KAFKA_OPTS="-Djava.security.auth.login.config=/etc/kafka/jaas/kafka_server_jaas.conf"

# ssl
KAFKA_SSL_KEYSTORE_FILENAME="kafka.server.keystore.jks"
KAFKA_SSL_KEYSTORE_LOCATION="/etc/kafka/secrets/kafka.server.keystore.jks"
# KAFKA_SSL_CLIENT_AUTH="none"

KAFKA_SSL_TRUSTSTORE_FILENAME="kafka.server.truststore.jks"
KAFKA_SSL_TRUSTSTORE_LOCATION="/etc/kafka/secrets/kafka.server.truststore.jks"
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=""
KAFKA_SSL_CLIENT_AUTH="required"  # Для mTLS

KAFKA_SSL_KEY_CREDENTIALS=ssl_key_credentials
KAFKA_SSL_KEYSTORE_CREDENTIALS=ssl_keystore_credentials
KAFKA_SSL_TRUSTSTORE_CREDENTIALS=ssl_truststore_credentials

KAFKA_METRIC_REPORTERS=io.confluent.metrics.reporter.ConfluentMetricsReporter
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_CONFLUENT_LICENSE_TOPIC_REPLICATION_FACTOR=1
KAFKA_CONFLUENT_BALANCER_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_JMX_PORT=9101
KAFKA_JMX_HOSTNAME=localhost
KAFKA_CONFLUENT_SCHEMA_REGISTRY_URL=http://schema-registry:8081
CONFLUENT_METRICS_REPORTER_BOOTSTRAP_SERVERS=broker1:29092
CONFLUENT_METRICS_REPORTER_TOPIC_REPLICAS=1
CONFLUENT_METRICS_ENABLE='true'
CONFLUENT_SUPPORT_CUSTOMER_ID='anonymous'