KAFKA_ZOOKEEPER_CONNECT=zookeeper-replica:2182
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:SSL,SASL_SSL:SASL_SSL
# ssl
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=https
KAFKA_SSL_CLIENT_AUTH=required  # Для mTLS
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_SSL_KEYSTORE_FILENAME=keystore.pkcs12
KAFKA_SSL_TRUSTSTORE_FILENAME=truststore.jks
KAFKA_SSL_KEYSTORE_CREDENTIALS=keystore_creds
KAFKA_SSL_KEY_CREDENTIALS=ssl_key_creds
KAFKA_SSL_TRUSTSTORE_CREDENTIALS=truststore_creds
# sasl
KAFKA_SASL_MECHANISM_INTER_BROKER_PROTOCOL=PLAIN
KAFKA_ALLOW_EVERYONE_IF_NO_ACL_FOUND=false
KAFKA_SASL_ENABLED_MECHANISMS=PLAIN,SASL_SSL
KAFKA_OPTS="-Djava.security.auth.login.config=/etc/kafka/jaas/kafka_server_jaas.conf"