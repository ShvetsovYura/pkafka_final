KAFKA_BROKER_ID=1
KAFKA_ADVERTISED_LISTENERS=INTERNAL://broker1:29092,EXTERNAL://b1.kafka.local:9193,SASL_SSL://b1.kafka.local:9194
KAFKA_LISTENERS=INTERNAL://:29092,EXTERNAL://:9193,SASL_SSL://:9194
KAFKA_JMX_PORT=9911
KAFKA_JMX_HOSTNAME=broker1
KAFKA_METRIC_REPORTERS=io.confluent.metrics.reporter.ConfluentMetricsReporter
CONFLUENT_METRICS_ENABLE=rue
KAFKA_JMX_OPTS="-Dcom.sun.management.jmxremote=true
-Dcom.sun.management.jmxremote.rmi.port=9911 
-Dcom.sun.management.jmxremote.authenticate=false 
-Dcom.sun.management.jmxremote.ssl=false 
-Djava.rmi.server.hostname=broker1
-Dcom.sun.management.jmxremote.local.only=false"

CONFLUENT_METRICS_REPORTER_BOOTSTRAP_SERVERS: broker1:29092
CONFLUENT_METRICS_REPORTER_TOPIC_REPLICAS: 1